[Unit]
Description=Homelab Manager API
After=network.target docker.service postgresql.service

[Service]
Type=notify
User=mikul
WorkingDirectory=/home/mikul/homelab-manager
ExecStart=/home/mikul/homelab-manager/venv/bin/gunicorn homelab.api.main:app \
  --workers 4 \
  --worker-class uvicorn.workers.UvicornWorker \
  --bind 0.0.0.0:3030
Restart=always

[Install]
WantedBy=multi-user.target